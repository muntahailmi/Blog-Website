<%- include("partials/header") %>
    <h1>Home 1.0.0</h1>
    <p> <%= startingContent %></p>
    

  <%  posts.forEach(function(post) { %>

       <h1><%= post.title %></h1>
       <p>
        <%= post.content.substring(0, 100) + " ..." %>
        <a href="/posts/<%=post._id%>">Read More</a>
       </p>

   <% }); %>

<%- include("partials/footer") %>